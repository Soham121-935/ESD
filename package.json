{
  "name": "esd-learning-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Electronic System Design (UETPE0513) engineering learning laboratory",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "smoke": "vite build --ssr src/smoke.tsx --outDir dist-smoke --logLevel error && node dist-smoke/smoke.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
